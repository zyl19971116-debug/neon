pragma solidity ^0.8.24;
import "@openzeppelin/contracts/token/ERC721/IERC721.sol";import "@openzeppelin/contracts/token/common/IERC2981.sol";import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";import "@openzeppelin/contracts/access/Ownable.sol";import "@openzeppelin/contracts/utils/Pausable.sol";
contract NeonGarageMarket is ReentrancyGuard,Ownable,Pausable {struct Listing{address seller;uint256 price;}mapping(address=>mapping(uint256=>Listing))public listings;mapping(address=>uint256)public proceeds;uint96 public feeBps;address public feeReceiver;event Listed(address indexed nft,uint256 indexed id,address seller,uint256 price);event Cancelled(address indexed nft,uint256 indexed id);event Bought(address indexed nft,uint256 indexed id,address buyer,uint256 price);constructor(address admin,address receiver,uint96 fee)Ownable(admin){require(fee<=1000,"fee too high");feeReceiver=receiver;feeBps=fee;}function list(address nft,uint256 id,uint256 price)external whenNotPaused{require(price>0,"zero price");require(IERC721(nft).ownerOf(id)==msg.sender,"not owner");require(IERC721(nft).isApprovedForAll(msg.sender,address(this))||IERC721(nft).getApproved(id)==address(this),"not approved");require(listings[nft][id].seller==address(0),"already listed");listings[nft][id]=Listing(msg.sender,price);emit Listed(nft,id,msg.sender,price);}function cancelListing(address nft,uint256 id)external{require(listings[nft][id].seller==msg.sender,"not seller");delete listings[nft][id];emit Cancelled(nft,id);}function buy(address nft,uint256 id)external payable nonReentrant whenNotPaused{Listing memory l=listings[nft][id];require(l.seller!=address(0)&&msg.value==l.price,"invalid sale");require(IERC721(nft).ownerOf(id)==l.seller,"stale owner");delete listings[nft][id];uint256 fee=l.price*feeBps/10000;uint256 royalty;address receiver;try IERC2981(nft).royaltyInfo(id,l.price)returns(address r,uint256 a){receiver=r;royalty=a;}catch{}require(fee+royalty<=l.price,"invalid fees");proceeds[l.seller]+=l.price-fee-royalty;proceeds[feeReceiver]+=fee;if(royalty>0)proceeds[receiver]+=royalty;IERC721(nft).safeTransferFrom(l.seller,msg.sender,id);emit Bought(nft,id,msg.sender,l.price);}function withdrawProceeds()external nonReentrant{uint256 a=proceeds[msg.sender];require(a>0,"none");proceeds[msg.sender]=0;(bool ok,)=payable(msg.sender).call{value:a}("");require(ok,"transfer failed");}function setFee(address receiver,uint96 fee)external onlyOwner{require(fee<=1000,"fee too high");feeReceiver=receiver;feeBps=fee;}function pause()external onlyOwner{_pause();}function unpause()external onlyOwner{_unpause();}}
